# ────────────────────────────────────────────────────────────────────────────
# AI Governance Crisis Simulator — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# Backend API base URL.
# In development the Vite proxy rewrites /api/* to http://localhost:8000/*,
# so you can leave this empty or set it to http://localhost:8000.
# In production set it to your deployed API URL.
VITE_API_BASE_URL=http://localhost:8000
