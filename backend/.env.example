# ────────────────────────────────────────────────────────────────────────────
# AI Governance Crisis Simulator — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="AI Governance Crisis Simulator"
APP_ENV=development
DEBUG=true

# ── Server ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crisis_simulator

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM Configuration — Phase 4+ ──────────────────────────────────────────
# Provider choices: "mock" (default, zero-cost, no API key needed)
#                   "anthropic" (requires ANTHROPIC_API_KEY or LLM_API_KEY)
#                   "openai"
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=your_llm_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=1

# ── RAG & Vector Store Configuration — Phase 9 ────────────────────────────
# RAG enabled flag (default: true)
RAG_ENABLED=true
# ChromaDB persistence directory
CHROMA_PERSIST_DIRECTORY=backend/data/chroma_db
CHROMA_COLLECTION_NAME=governance_documents
# Embedding provider: "mock" (default, zero-cost, no API key required)
#                    "sentence_transformers" (local HuggingFace model)
#                    "openai" (requires EMBEDDING_API_KEY)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=your_embedding_api_key_here
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Phase 14 — Demo Path, Seeded Replay & Fallbacks ────────────────────────
APP_MODE=LIVE
DEMO_SEED=42
DEMO_SCENARIO_ID=scenario_01
DEMO_DETERMINISTIC=true
LLM_REQUIRED_FOR_DEMO=false

