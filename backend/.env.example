# ────────────────────────────────────────────────────────────────────────────
# AI Governance Crisis Simulator — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="AI Governance Crisis Simulator"
APP_ENV=development
DEBUG=true

# ── Server ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crisis_simulator

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM (Anthropic) — Phase 3+ ───────────────────────────────────────────────
# Obtain your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
