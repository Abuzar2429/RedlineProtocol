# ────────────────────────────────────────────────────────────────────────────
# AI Governance Crisis Simulator — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="AI Governance Crisis Simulator"
APP_ENV=development
DEBUG=true

# ── Server ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crisis_simulator

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM Configuration — Phase 4+ ──────────────────────────────────────────
# Provider choices: "mock" (default, zero-cost, no API key needed)
#                   "anthropic" (requires ANTHROPIC_API_KEY or LLM_API_KEY)
#                   "openai"
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=your_llm_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=1

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
